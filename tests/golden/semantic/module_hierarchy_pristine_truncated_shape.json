{
  "name": "Pristine moduleHierarchy request shape exposes partial truncation metadata",
  "config": {
    "topModules": [
      "top"
    ]
  },
  "sources": [
    {
      "uri": "file:///golden/semantic/pristine-hierarchy-truncated.sv",
