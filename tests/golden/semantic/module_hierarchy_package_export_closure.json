      "text": "package api;\n  export defs::*;\nendpackage\n"
    },
    {
      "uri": "file:///golden/semantic/export-closure-child.sv",
      "text": "module child;\nendmodule\n"
    },
    {
      "uri": "file:///golden/semantic/export-closure-top.sv",
      "text": "module top;\n  import api::*;\n  child u_child();\nendmodule\n"
