{
  "name": "module hierarchy marks cyclic child as partial",
  "config": {
    "topModules": [
      "top"
    ]
  },
  "sources": [
    {
      "uri": "file:///golden/semantic/hierarchy-cycle.sv",
      "text": "module top;\n  top u_self();\nendmodule\n"
    }
